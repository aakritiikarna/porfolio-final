# Copy this file to .env.local and fill in real values. .env.local is git-ignored; never commit it.
# These are read on the server only. None of them is ever sent to the browser.

# ---- Contact form email (required for the form to work) ----
# Where messages are delivered (your inbox):
CONTACT_TO_EMAIL=your-email@gmail.com

# SMTP server. Gmail example (needs 2-Step Verification + an App Password, see README):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional. Defaults to SMTP_USER. Most providers only allow an address that belongs to your account.
# CONTACT_FROM_EMAIL=your-email@gmail.com

# ---- Optional: keep a copy of each message in MongoDB ----
# Leave unset to skip. The form works without a database.
# MONGO_URL=mongodb://localhost:27017/aakriti-portfolio

# ---- Optional: lets you read stored messages at GET /api/messages with "Authorization: Bearer <token>" ----
# Leave unset to keep that endpoint switched off. Use a long random value if you set it.
# ADMIN_TOKEN=
